    "name =input(\"What is your name?\")\n",
    "age = int(input(\"How old are you?\"))\n",
    "if age<100:\n",
    "    years = 100 - age\n",
    "    print(f\"{name},you have {years} years until you are 100\")\n",
    "else:\n",
    "    years = age- 100\n",
    "    print(f\"{name},you are {years} years over 100\")\n"
   ]
